{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/view/:slug/:page",
      "destination": "/api/public-view?slug=:slug"
    },
    {
      "source": "/view/:slug",
      "destination": "/api/public-view?slug=:slug"
    },
    {
      "source": "/stock",
      "destination": "/index.html"
    },
    {
      "source": "/overview",
      "destination": "/index.html"
    },
    {
      "source": "/reports",
      "destination": "/index.html"
    },
    {
      "source": "/sro-quantity",
      "destination": "/index.html"
    },
    {
      "source": "/issuance",
      "destination": "/index.html"
    },
    {
      "source": "/clients",
      "destination": "/index.html"
    },
    {
      "source": "/spreadsheet",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/superadmin",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/public-view.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
